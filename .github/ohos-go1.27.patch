+				libpath, sect.Name)
+		}
+		entSize := 24
+		if len(sectData)%entSize != 0 {
+			log.Fatalf("malformed shlib %s, sect %s size=%d",
+				libpath, sect.Name, len(sectData))
+		}
+		relocsNum := len(sectData) / entSize
+		b := bytes.NewReader(sectData)
